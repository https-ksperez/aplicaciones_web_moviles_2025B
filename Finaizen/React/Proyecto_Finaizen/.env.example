# ===============================================
# CONFIGURACIÓN DE APIs - Finaizen
# ===============================================
# Copia este archivo como .env y completa las claves API

# ===============================================
# BACKEND API URL
# ===============================================
VITE_API_URL=http://localhost:5000/api

# ===============================================
# OCR API - Para escaneo de recibos
# ===============================================

# OCR.space API (Free tier - 25,000 requests/month)
# Obtener API key en: https://ocr.space/ocrapi
VITE_OCR_SPACE_API_KEY=TU_API_KEY_AQUI

# Google Cloud Vision API
# Obtener API key en: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_VISION_API_KEY=TU_API_KEY_AQUI

# ===============================================
# Speech-to-Text API - Para notas de voz
# ===============================================

# Web Speech API (Nativa del navegador - NO REQUIERE API KEY)
# Funciona en Chrome, Edge, Safari

# Google Cloud Speech-to-Text API
VITE_GOOGLE_SPEECH_API_KEY=TU_API_KEY_AQUI

# ===============================================
# AI Processing API - Para análisis de texto
# ===============================================

# OpenAI GPT API
# Obtener API key en: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=TU_API_KEY_AQUI

# Google Gemini API
# Obtener en: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=TU_API_KEY_AQUI

# ===============================================
# NOTAS DE CONFIGURACIÓN
# ===============================================
# 
# 1. CONFIGURACIÓN GRATUITA (Recomendada para desarrollo):
#    - OCR: OCR.space (registrarse para obtener key gratuita)
#    - Speech: Web Speech API (nativa, sin key)
#    - AI: Google Gemini (tiene tier gratuito)
#
# 2. NUNCA subas el archivo .env a git
#    El archivo .env está en .gitignore
