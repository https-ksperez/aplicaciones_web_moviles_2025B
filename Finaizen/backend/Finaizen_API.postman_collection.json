{
  "info": {
    "name": "Finaizen API",
    "description": "Colección completa de endpoints del API de Finaizen",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "perfilId",
      "value": "",
