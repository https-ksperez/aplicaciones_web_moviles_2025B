            "body": {
              "mode": "raw",
              "raw": "{\n  \"contraseñaActual\": \"password123\",\n  \"contraseñaNueva\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "change-password"]
            }
          }
        }
      ]
