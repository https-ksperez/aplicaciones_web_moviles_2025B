# ===============================================
# CONFIGURACIÓN DE APIs - FinaizenMobile
# ===============================================
# 
# NOTA: Las API keys ya están precargadas en src/config/apiConfig.js
# Este archivo es de referencia para documentar las APIs usadas.
#
# En React Native con Expo, las variables de entorno se manejan 
# diferente a la web. Las claves están definidas directamente
# en el archivo de configuración.
#
# Si necesitas cambiar alguna API key, edita:
# src/config/apiConfig.js
#
# ===============================================

# ===============================================
# BACKEND API URL
# ===============================================
API_URL=http://localhost:5000/api

# ===============================================
# OCR API - Para escaneo de recibos
# ===============================================

# OCR.space API (Free tier - 25,000 requests/month)
# Obtener API key en: https://ocr.space/ocrapi
OCR_SPACE_API_KEY=TU_OCR_SPACE_API_KEY_AQUI

# Google Cloud Vision API
# Obtener API key en: https://console.cloud.google.com/apis/credentials
GOOGLE_VISION_API_KEY=TU_GOOGLE_VISION_API_KEY_AQUI

# ===============================================
# Speech-to-Text API - Para notas de voz
# ===============================================

# Google Cloud Speech-to-Text API
GOOGLE_SPEECH_API_KEY=TU_GOOGLE_SPEECH_API_KEY_AQUI

# OpenAI Whisper API (recomendado para mejor precisión)
OPENAI_API_KEY=TU_OPENAI_API_KEY_AQUI

# ===============================================
# AI Processing API - Para análisis de texto
# ===============================================

# Google Gemini API
GEMINI_API_KEY=TU_GEMINI_API_KEY_AQUI
